# What the pod is built from. bootstrap.sh reads this; change versions here.

# ComfyUI release the workflow needs (MiniMax H3 + SAM3 nodes).
COMFYUI_TAG=v0.43.1

# Node packs: "<git url> <commit>", one per line.
NODE_PACKS="
https://github.com/rgthree/rgthree-comfy.git 218d6347dac5b6499ae56dbfeb25cbb6dd203ac5
https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git 4d907bee61e92c2e65af3bd6383a4e4d356126d1
https://github.com/SeanScripts/ComfyUI-Unload-Model.git ac5ffb4ed05546545ce7cf38e7b69b5152714eed
"

# Extra ComfyUI startup options. Partner nodes are off so ComfyUI never asks
# for a Comfy account; the workflow's paid Gemini route is not used.
COMFYUI_ARGS="--disable-partner-nodes"

# Which model list in models/ to download when H3_MODELS is not set.
DEFAULT_MODEL_SET=compressed
